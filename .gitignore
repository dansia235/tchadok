# ================================================================
# .gitignore - Tchadok Platform
# ================================================================

# ----------------------------------------------------------------
# Environnement et configuration sensible
# Aucun fichier d'environnement reel n'est versionne : seuls les
# modeles *.example le sont. Voir docs/exploitation/secrets.md
# ----------------------------------------------------------------
.env
.env.local
.env.production
.env.*.local
config.local.php

# Les modeles, eux, sont versionnes
!.env.local.example
!.env.production.example

# ----------------------------------------------------------------
# Apache (CFG-04)
# .htaccess est GENERE par scripts/env-switch.php depuis
# .htaccess.local ou .htaccess.production, qui sont les sources
# versionnees. Ne jamais modifier .htaccess a la main : il est ecrase
# a chaque bascule.
# ----------------------------------------------------------------
.htaccess
.htaccess.remplace-*
!.htaccess.local
!.htaccess.production
# Protections locales de sous-repertoires (storage/, uploads/...)
!*/.htaccess

# Logs
*.log
logs/
storage/logs/

# Contenu de storage/ (la structure est conservee via .gitkeep)
# Place APRES la regle "cache/" ci-dessus, sinon storage/cache serait ignore.
storage/**
!storage/
!storage/*/
!storage/**/.gitkeep

# Cache et fichiers temporaires
cache/
!storage/cache/
tmp/
temp/
*.tmp
*.cache
*.swp
*.swo
*~

# Uploads et médias utilisateurs
uploads/*
!uploads/.gitkeep
storage/app/*
!storage/app/.gitkeep

# Vendor et dépendances
vendor/
node_modules/
bower_components/

# Composer
composer.lock
composer.phar

# NPM
package-lock.json
npm-debug.log
yarn-error.log

# IDE et éditeurs
.idea/
.vscode/
.vs/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Système
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Backups
*.bak
*.backup
*.sql
*.sql.gz
backup/
backups/

# Exception : Autoriser les scripts SQL dans le dossier sql/
!sql/*.sql

# Fichiers de session
storage/sessions/
sessions/

# Documentation compilée
docs/_build/
site/

# Tests et coverage
phpunit.xml
.phpunit.result.cache
coverage/
.coverage
htmlcov/

# Certificats SSL
*.pem
*.key
*.crt
*.csr

# Variables spécifiques au développeur
.env.developer
local.config.php
