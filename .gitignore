# ================================================================
# .gitignore - Tchadok Platform
# ================================================================

# ----------------------------------------------------------------
# Environnement et configuration sensible
# Aucun fichier d'environnement reel n'est versionne : seuls les
# modeles *.example le sont. Voir docs/exploitation/secrets.md
# ----------------------------------------------------------------
.env
.env.local
.env.production
.env.*.local
config.local.php

# Les modeles, eux, sont versionnes
!.env.local.example
!.env.production.example

# ----------------------------------------------------------------
# Apache (CFG-04)
# .htaccess est GENERE par scripts/env-switch.php depuis
# .htaccess.local ou .htaccess.production, qui sont les sources
# versionnees. Ne jamais modifier .htaccess a la main : il est ecrase
# a chaque bascule.
# ----------------------------------------------------------------
.htaccess
.htaccess.remplace-*
!.htaccess.local
!.htaccess.production
# Protections locales de sous-repertoires (storage/, uploads/...)
!*/.htaccess

# Logs
*.log
logs/
storage/logs/

# Contenu de storage/ (la structure est conservee via .gitkeep)
# Place APRES la regle "cache/" ci-dessus, sinon storage/cache serait ignore.
storage/**
!storage/
!storage/**/
!storage/**/.gitkeep

# Cache et fichiers temporaires
cache/
!storage/cache/
tmp/
temp/
*.tmp
*.cache
*.swp
*.swo
*~

# Uploads et médias utilisateurs
# Le CONTENU depose n'est jamais versionne. En revanche, les .htaccess qui
# le protegent DOIVENT l'etre (SEC-06) : sans eux, un nouveau clone ou un
# deploiement servirait l'audio en acces direct et executerait tout .php
# depose.
uploads/*
!uploads/.gitkeep
!uploads/.htaccess
!uploads/*/
uploads/*/*
!uploads/*/.htaccess
!uploads/*/.gitkeep
storage/app/*
!storage/app/.gitkeep

# Protections de storage/ (meme raison)
!storage/.htaccess
!storage/**/.htaccess

# Vendor et dépendances
vendor/
node_modules/
bower_components/

# Composer
composer.lock
composer.phar

# NPM
package-lock.json
npm-debug.log
yarn-error.log

# IDE et éditeurs
.idea/
.vscode/
.vs/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Système
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Backups
*.bak
*.backup
*.sql
*.sql.gz
backup/
backups/

# Exceptions : scripts SQL versionnes.
# La regle *.sql ci-dessus vise les exports et sauvegardes ; elle ne doit
# pas masquer le schema de reference, les migrations ni les donnees de
# reference. Sans ces exceptions, database/seeds/demo.sql et toute
# migration de database/migrations/ seraient silencieusement ignores.
!sql/*.sql
!database/tchadok.sql
!database/migrations/*.sql
!database/seeds/*.sql
!tests/**/*.sql

# Fichiers de session
storage/sessions/
sessions/

# Documentation compilée
docs/_build/
site/

# Tests et coverage
phpunit.xml
.phpunit.result.cache
coverage/
.coverage
htmlcov/

# Certificats SSL
*.pem
*.key
*.crt
*.csr

# Variables spécifiques au développeur
.env.developer
local.config.php


# PAY-03 : etat des simulateurs de paiement (transactions, file, journal).
# Le code de mock-gateways/ est versionne ; son etat ne l'est jamais.
mock-gateways/storage/
