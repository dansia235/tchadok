# SEC-06 : acces direct interdit.
# Les fichiers de ce repertoire ne sont servis QUE par media.php, apres
# verification de la signature de l'URL et du droit d'acces.
# Sans cette regle, tout titre payant etait telechargeable par URL directe.
Require all denied
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
Options -Indexes