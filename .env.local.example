# ================================================================
# TCHADOK - ENVIRONNEMENT LOCAL (modele)
# ================================================================
#
# Copiez ce fichier en .env.local et renseignez les valeurs.
#   copy .env.local.example .env.local
#
# Ce fichier est un MODELE versionne : il ne doit contenir aucune
# valeur reelle. Le fichier .env.local, lui, n'est jamais versionne.
#
# Ordre de resolution applique par config/env.php :
#   1. .env.local       -> environnement LOCAL
#   2. .env.production  -> environnement PRODUCTION
#   3. aucun des deux   -> erreur fatale explicite
#
# En production, .env.local est SUPPRIME du serveur. Sa presence
# aux cotes d'une configuration de production declenche un arret
# immediat (garde-fou CFG-05).
#
# Les identifiants locaux peuvent rester simples : ce poste n'est pas
# expose. Ce qui protege la production n'est pas la complexite des
# valeurs locales, c'est l'impossibilite technique qu'elles y arrivent.
# ================================================================

# ---- Environnement ----------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_NAME="Tchadok (local)"
APP_TIMEZONE=Africa/Ndjamena

# URL de base, sans barre oblique finale.
# XAMPP avec le projet dans htdocs/tchadok :
APP_URL=http://localhost/tchadok
SITE_URL=http://localhost/tchadok

# ---- Base de donnees --------------------------------------------
# Base LOCALE dediee. Ne jamais pointer vers une base de production.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tchadok_local
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Compte utilise par scripts/backup.ps1.
# Peut etre le meme qu'au-dessus en local. En production, utilisez un
# compte distinct en lecture seule (voir docs/exploitation/sauvegarde.md).
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=

# ---- Cles ---------------------------------------------------------
# Generer : php -r "echo rtrim(strtr(base64_encode(random_bytes(32)),'+/','Aa'),'=');"
# En local elles peuvent rester simples. En production, elles doivent
# etre generees aleatoirement et differentes de celles-ci.
APP_KEY=
SESSION_SECRET=

# ---- Sessions -----------------------------------------------------
SESSION_LIFETIME=7200
ADMIN_SESSION_LIFETIME=7200
# false en local : le cookie Secure n'est pas transmis en HTTP
SESSION_SECURE=false
SESSION_SAMESITE=Lax
# Duree du cookie "se souvenir de moi", en secondes (30 jours). SEC-11.
REMEMBER_LIFETIME=2592000
# Limitation de debit et verrouillage des connexions (SEC-12). Ne desactiver
# qu'en developpement, jamais en production.
RATE_LIMIT_ENABLED=true
# SEC-20 : second facteur obligatoire pour tout role disposant d'un droit
# d'ecriture en administration. false en local pour ne pas imposer un telephone
# a chaque essai ; true en production, des que les administrateurs l'ont active.
ADMIN_2FA_REQUIRED=false

# ---- Proxys de confiance ------------------------------------------
# Adresses ou plages CIDR separees par des virgules. Vide en local.
# X-Forwarded-For n'est lu QUE si la requete vient d'une de ces IP.
TRUSTED_PROXIES=

# SEC-18 : origines autorisees a lire les API publiques depuis un navigateur,
# separees par des virgules. Vide = meme origine uniquement, ce qui est le cas
# normal. L'application Android n'a pas besoin de cette liste.
CORS_ALLOWED_ORIGINS=

# ---- Stockage ------------------------------------------------------
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE=52428800

# ---- Courriel ------------------------------------------------------
# 'log' ecrit dans storage/logs/mail.log sans rien envoyer.
# Ne jamais mettre 'smtp' en local avec un vrai serveur : on finit par
# envoyer des courriels de test a de vrais utilisateurs.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@tchadok.local
MAIL_FROM_NAME="Tchadok (local)"

# ---- SMS (code de verification du telephone) -------------------------
# 'log' ecrit dans storage/logs/sms.log sans rien envoyer.
SMS_DRIVER=log

# ---- Paiement ------------------------------------------------------
# mock = simulateurs locaux (LOT 5). 'live' est REFUSE en local.
# Demarrer les simulateurs : scripts\mock-gateways.bat
# Contrat commun aux quatre passerelles : docs/paiement/contrat-generique.md
PAYMENT_DRIVER=mock
PAYMENT_CALLBACK_BASE=http://localhost/tchadok
# Duree de vie d'une tentative sans reponse de l'operateur (secondes).
PAYMENT_INTENT_TTL=900
# Rapprochement quotidien (PAY-10) : alerte au-dela de ce pourcentage d'ecarts.
RECONCILIATION_ALERT_RATE=1
# Livraison (SHOP-05) : ouvertures de fichiers par compte et par 10 minutes.
MEDIA_OUVERTURES_MAX=120
# Cours du dollar : auto = API gratuite (open.er-api.com, puis frankfurter.app),
# taux de secours sans connexion. manuel = scripts/devises.php definir.
DEVISES_COURS=auto
DEVISE_USD_SECOURS=600
DEVISES_RAFRAICHIR_HEURES=6
DEVISES_VALIDITE_HEURES=24
# Certification des ecoutes (STAT-03) : seuils des signaux de fraude.
CERTIF_DELAI_OBSERVATION=7200
CERTIF_RAFALE_IP_HEURE=40
CERTIF_TITRE_VOLUME_MIN=50
CERTIF_RATIO_MAX=8
CERTIF_CONCENTRATION_POURCENT=80
CERTIF_COMPTES_RAFALE=10
CERTIF_NUIT_VOLUME=100
CERTIF_ALERTE_POURCENT=5
# Versements aux artistes (LOT 8) : seuil de demande (FCFA) et retention (jours).
PAYOUT_MINIMUM=10000
PAYOUT_RETENTION_DAYS=30
# Part des abonnements : duree minimale d'une ecoute retenue (secondes). Le
# pourcentage reverse aux artistes se regle dans admin/remuneration.php.
REPARTITION_ECOUTE_MIN_SECONDES=30

# ---- Factures (SHOP-03) ------------------------------------------
# Mentions de l'editeur, a fournir par la direction. Rien n'est invente.
FACTURE_EDITEUR="Tchadok"
FACTURE_ADRESSE="N'Djamena, Tchad"
FACTURE_IDENTIFIANTS="RCCM : a completer - NIF : a completer"
FACTURE_TVA_MENTION="TVA non applicable (regime a confirmer)"

AIRTEL_BASE_URL=http://127.0.0.1:9101
AIRTEL_MERCHANT_ID=mock-client
AIRTEL_API_KEY=mock-secret
AIRTEL_WEBHOOK_SECRET=

MOOV_BASE_URL=http://127.0.0.1:9102
MOOV_MERCHANT_ID=mock-merchant
MOOV_API_KEY=mock-key
MOOV_WEBHOOK_SECRET=

VISA_BASE_URL=http://127.0.0.1:9103
VISA_MERCHANT_ID=mock-merchant
VISA_API_KEY=mock-key
VISA_WEBHOOK_SECRET=

GIMAC_BASE_URL=http://127.0.0.1:9104
GIMAC_MERCHANT_ID=mock-merchant
GIMAC_API_KEY=mock-key
GIMAC_WEBHOOK_SECRET=

# ---- Outils externes ------------------------------------------------
# Requis par STAT-02 (duree reelle d'un titre) et MOD-04 (extrait 30 s).
FFPROBE_PATH=
FFMPEG_PATH=

# ---- Cache et journaux ----------------------------------------------
CACHE_DRIVER=file
CACHE_LIFETIME=3600
LOG_LEVEL=debug

# ---- Radio (Icecast / Liquidsoap) ------------------------------------
RADIO_ENGINE_ENABLED=true
RADIO_STREAM_PUBLIC_URL=http://localhost:8000/tchadok.mp3
RADIO_STREAM_FALLBACK_URL=/api/radio/stream
ICECAST_STATUS_URL=http://127.0.0.1:8000/status-json.xsl
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=
RADIO_ENGINE_MOUNT=/tchadok.mp3
RADIO_ENGINE_TIMEOUT=5
RADIO_ENGINE_PREFER_STREAM=true
# false en local : Icecast renvoie souvent un hostname non resolu
RADIO_ENGINE_USE_STATUS_LISTENURL=false

# ---- Garde-fous -------------------------------------------------------
# Autorise les outils de developpement. Toujours false en production.
ALLOW_DEV_TOOLS=true
FORCE_HTTPS=false
HSTS_ENABLED=false
