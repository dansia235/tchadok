# ================================================================
# TCHADOK - ENVIRONNEMENT DE PRODUCTION (modele)
# ================================================================
#
# Ce fichier est un MODELE versionne. Il ne doit contenir AUCUNE
# valeur reelle : ni mot de passe, ni cle d'API, ni identifiant.
#
# Sur le serveur :
#   1. copier ce modele en .env.production
#   2. renseigner chaque valeur
#   3. restreindre les droits du fichier (600, proprietaire = compte web)
#   4. NE JAMAIS le versionner
#
# Toute valeur laissee a REMPLACER, CHANGEZ-MOI, votre-, YOUR_ ou
# commencant par mock- empeche le demarrage de l'application
# (garde-fou CFG-05, includes/environment-guard.php).
#
# Avant la mise en ligne, verifier que .env.local et .htaccess.local
# sont ABSENTS du serveur, et que .htaccess a bien ete genere depuis
# .htaccess.production par scripts/env-switch.php.
#
# Procedure de rotation : docs/exploitation/secrets.md
# ================================================================

# ---- Environnement ----------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_NAME="Tchadok"
APP_TIMEZONE=Africa/Ndjamena

# Domaine reel, en HTTPS, sans barre oblique finale
APP_URL=https://REMPLACER.td
SITE_URL=https://REMPLACER.td

# ---- Base de donnees --------------------------------------------
# Le compte applicatif doit etre limite au DML :
#   GRANT SELECT, INSERT, UPDATE, DELETE ON <base>.* TO '<user>'@'localhost';
# Ni GRANT ALL, ni SUPER, ni DDL, ni TRIGGER.
# Les migrations utilisent un compte distinct, hors serveur web.
# La base ne doit PAS etre joignable depuis Internet.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REMPLACER
DB_USERNAME=REMPLACER
DB_PASSWORD=REMPLACER
DB_CHARSET=utf8mb4

# Compte de sauvegarde, distinct et en lecture seule :
#   GRANT SELECT, SHOW VIEW, LOCK TABLES, TRIGGER, EVENT ON <base>.*
# Jamais ON *.* : le compte pourrait lire toutes les bases du serveur.
BACKUP_DB_USERNAME=REMPLACER
BACKUP_DB_PASSWORD=REMPLACER

# ---- Cles ---------------------------------------------------------
# Generer une valeur DIFFERENTE de celle du poste de developpement :
#   openssl rand -base64 32
# Changer APP_KEY rend illisible toute donnee chiffree avec l'ancienne.
# Changer SESSION_SECRET deconnecte tous les utilisateurs.
APP_KEY=REMPLACER
SESSION_SECRET=REMPLACER

# ---- Sessions -----------------------------------------------------
# Duree en secondes. Sessions d'administration plus courtes.
SESSION_LIFETIME=1800
ADMIN_SESSION_LIFETIME=900
# true en production : le cookie n'est transmis qu'en HTTPS
SESSION_SECURE=true
SESSION_SAMESITE=Lax
# Duree du cookie "se souvenir de moi", en secondes (30 jours). SEC-11.
REMEMBER_LIFETIME=2592000
# Limitation de debit et verrouillage des connexions (SEC-12). Ne desactiver
# qu'en developpement, jamais en production.
RATE_LIMIT_ENABLED=true

# ---- Proxys de confiance ------------------------------------------
# Adresses ou plages CIDR du reverse proxy ou du CDN, separees par des virgules.
# X-Forwarded-For n'est lu QUE si la requete vient d'une de ces IP.
# Laisser vide si le serveur web est expose directement : sinon
# n'importe qui peut falsifier son adresse IP dans les journaux,
# la geographie du barometre et la limitation de debit.
TRUSTED_PROXIES=

# SEC-18 : origines autorisees a lire les API publiques depuis un navigateur,
# separees par des virgules. Vide = meme origine uniquement, ce qui est le cas
# normal. L'application Android n'a pas besoin de cette liste.
CORS_ALLOWED_ORIGINS=

# ---- Stockage ------------------------------------------------------
# Chemin ABSOLU, hors de la racine web.
STORAGE_PATH=/var/www/tchadok-storage
UPLOAD_MAX_SIZE=52428800

# ---- Courriel ------------------------------------------------------
# Configurer SPF, DKIM et DMARC sur le domaine avant la mise en ligne.
MAIL_DRIVER=smtp
MAIL_HOST=REMPLACER
MAIL_PORT=587
MAIL_USERNAME=REMPLACER
MAIL_PASSWORD=REMPLACER
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@REMPLACER.td
MAIL_FROM_NAME="Tchadok"

# ---- Paiement ------------------------------------------------------
# 'live' obligatoire en production. La valeur 'mock' empeche le
# demarrage : encaisser dans le vide est le pire scenario possible.
PAYMENT_DRIVER=live
PAYMENT_CALLBACK_BASE=https://REMPLACER.td

# Identifiants fournis par chaque partenaire apres contractualisation
# (tache PAY-11). Penser a declarer l'IP publique du serveur aupres de
# chaque operateur, et a ouvrir leurs IP de callback au pare-feu.
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=REMPLACER
AIRTEL_CLIENT_SECRET=REMPLACER
AIRTEL_WEBHOOK_SECRET=REMPLACER

MOOV_BASE_URL=REMPLACER
MOOV_MERCHANT_ID=REMPLACER
MOOV_API_KEY=REMPLACER
MOOV_WEBHOOK_SECRET=REMPLACER

VISA_BASE_URL=REMPLACER
VISA_MERCHANT_ID=REMPLACER
VISA_API_KEY=REMPLACER
VISA_WEBHOOK_SECRET=REMPLACER

KONOOM_BASE_URL=REMPLACER
KONOOM_MERCHANT_ID=REMPLACER
KONOOM_API_KEY=REMPLACER
KONOOM_WEBHOOK_SECRET=REMPLACER

# ---- Outils externes ------------------------------------------------
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_PATH=/usr/bin/ffmpeg

# ---- Cache et journaux ----------------------------------------------
CACHE_DRIVER=file
CACHE_LIFETIME=3600
LOG_LEVEL=error

# ---- Radio (Icecast / Liquidsoap) ------------------------------------
RADIO_ENGINE_ENABLED=true
# HTTPS obligatoire si le site est en HTTPS, sinon le navigateur bloque
# le flux (contenu mixte).
RADIO_STREAM_PUBLIC_URL=https://radio.REMPLACER.td/tchadok.mp3
RADIO_STREAM_FALLBACK_URL=/api/radio/stream
# Idealement accessible seulement depuis le serveur web
ICECAST_STATUS_URL=http://127.0.0.1:8000/status-json.xsl
ICECAST_ADMIN_USER=REMPLACER
ICECAST_ADMIN_PASSWORD=REMPLACER
RADIO_ENGINE_MOUNT=/tchadok.mp3
RADIO_ENGINE_TIMEOUT=5
RADIO_ENGINE_PREFER_STREAM=true
RADIO_ENGINE_USE_STATUS_LISTENURL=true

# ---- Garde-fous -------------------------------------------------------
# Toujours false en production. true empeche le demarrage.
ALLOW_DEV_TOOLS=false
FORCE_HTTPS=true
HSTS_ENABLED=true
