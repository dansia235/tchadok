###########################################
# Stream engine stack (Icecast + Liquidsoap)
###########################################

# Domaine public du stream
RADIO_DOMAIN=radio.tchadok.td
SITE_URL=https://tchadok.td

# Ports locaux VPS
ICECAST_PORT=8000
LIQUIDSOAP_HARBOR_PORT=9000

# Mount public
ICECAST_MOUNT=/tchadok.mp3

# Credentials Icecast
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change-me-admin
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_RELAY_PASSWORD=change-me-relay

# Credentials input harbor Liquidsoap
LIQ_HARBOR_PASSWORD=change-me-harbor

