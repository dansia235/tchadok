# ================================================================
# TCHADOK - APACHE, PRODUCTION
# ================================================================
#
# Tache CFG-04.
#
# Ce fichier est une SOURCE. Apache ne lit que le fichier nomme
# exactement ".htaccess" : il ignore totalement celui-ci.
#
# Mise en place, lors du deploiement :
#   php scripts/env-switch.php production
#
# ATTENTION : supprimer .htaccess.local du serveur ne suffit PAS.
# Si aucun fichier ".htaccess" n'est en place, Apache n'applique
# AUCUNE de ces regles, silencieusement : ni blocage des fichiers
# sensibles, ni en-tetes de securite, ni redirection HTTPS. Le site
# fonctionne en apparence, sans aucune protection.
# Le garde-fou applicatif (CFG-05) detecte cette situation et arrete
# l'application plutot que de servir un site non protege.
# ================================================================

# ---------------------------------------------------------------
# Reecriture
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Certificats ACME : laisser passer AVANT la redirection HTTPS,
    # sinon le renouvellement automatique echoue.
    RewriteRule ^\.well-known/ - [L]

    # HTTPS obligatoire
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # www -> apex
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Fichiers sensibles
    RewriteRule ^\.env - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule ^package(-lock)?\.json$ - [F,L]

    # Repertoires qui ne doivent jamais etre servis.
    # mock-gateways et tests ne devraient pas etre presents en
    # production : ce blocage est une defense en profondeur.
    RewriteRule ^(includes|config|database|scripts|storage|tests|mock-gateways|docs|vendor|node_modules|infra)/ - [F,L]

    # URL sans extension -> fichier PHP correspondant
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

# ---------------------------------------------------------------
# Fichiers sensibles
# ---------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# .txt n'est volontairement PAS bloque : robots.txt doit rester lisible.
<FilesMatch "\.(env|htaccess|htpasswd|ini|log|sh|sql|md|bak|dist|yml|yaml|ps1)$">
    Require all denied
</FilesMatch>

<Files ".well-known">
    Require all granted
</Files>

# ---------------------------------------------------------------
# PHP
# ---------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_flag log_errors On

    # error_reporting reste a E_ALL : on journalise tout, on n'affiche rien.
    # L'ancienne configuration posait error_reporting 0, ce qui faisait
    # disparaitre les erreurs des journaux aussi.
    php_value error_reporting 32767

    php_value upload_max_filesize 50M
    php_value post_max_size 52M
    php_value memory_limit 512M
    php_value max_execution_time 120
    php_value max_input_time 120

    php_value session.gc_maxlifetime 1800
    php_flag session.cookie_httponly On
    php_flag session.cookie_secure On
    # Lax et non Strict : Strict casse le retour depuis une page de
    # paiement hebergee (VISA, 3-D Secure), le cookie de session
    # n'etant pas renvoye lors de la redirection entrante.
    php_value session.cookie_samesite Lax
    php_flag session.use_strict_mode On

    php_flag expose_php Off
    php_value date.timezone "Africa/Ndjamena"
</IfModule>

# Note : ne PAS tenter de poser disable_functions ici. C'est une
# directive PHP_INI_SYSTEM, inapplicable depuis un .htaccess. La version
# precedente de ce fichier en declarait une incluant curl_exec, ce qui
# aurait coupe toutes les passerelles de paiement si elle avait pris
# effet. Le durcissement de PHP se fait dans php.ini.

# ---------------------------------------------------------------
# En-tetes de securite
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set X-Tchadok-Env "production"

    # HSTS : n'activer qu'apres validation du certificat sur tous les
    # sous-domaines. Une erreur ici rend le site inaccessible pendant
    # toute la duree du max-age, sans possibilite de retour arriere
    # cote navigateur.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Politique de securite du contenu.
    # En Report-Only tant que Tailwind est charge depuis son CDN : le
    # compilateur navigateur exige 'unsafe-eval'. Basculer en
    # Content-Security-Policy (bloquante) apres la tache UX-03, qui
    # compile Tailwind localement.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report.php"

    # Aucun en-tete CORS global.
    # L'ancienne configuration posait Access-Control-Allow-Origin "*" sur
    # TOUTES les reponses, pages HTML comprises, avec GET/POST/PUT/DELETE.
    # Le CORS se declare desormais endpoint par endpoint (tache SEC-18).

    # setifempty et non set : un script qui definit lui-meme sa politique
    # de cache doit la conserver. media.php pose "private, max-age=3600" pour
    # que le navigateur garde l'audio en cache ; "set" l'ecrasait, et chaque
    # reecoute retelechargeait le titre -- couteux en donnees mobiles.
    <FilesMatch "\.(php)$">
        Header setifempty Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>

    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ---------------------------------------------------------------
# Compression et cache
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Les actifs doivent porter une empreinte dans leur nom pour que
    # ces durees longues soient sures (tache UX-03).
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------
# Divers
# ---------------------------------------------------------------
Options -Indexes
Options +FollowSymLinks
ServerSignature Off
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
    AddType audio/mpeg mp3
    AddType audio/mp4 m4a
    AddType audio/ogg ogg
    AddType audio/wav wav
    AddType video/mp4 mp4
    AddType application/json json
    AddType font/woff2 woff2
    AddType image/svg+xml svg svgz
    AddType application/manifest+json webmanifest
</IfModule>

ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
# SEC-16 : refus prononce par le serveur web lui-meme (la limitation
# applicative de SEC-12 rend sa propre reponse, avec le delai d'attente).
ErrorDocument 429 /429.php
